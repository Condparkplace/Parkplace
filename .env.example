# ===============================================
# Configuracao do Supabase - Park Place Portaria
# Copie este arquivo para ".env" e preencha os valores
# ===============================================

# URL do seu projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica "anon" (Settings > API > Project API keys > anon public)
# Usada para autenticacao dos usuarios (login).
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave "service_role" (Settings > API > Project API keys > service_role)
# ATENCAO: chave secreta de administrador. NUNCA exponha no frontend.
# Usada no backend para criar usuarios e operacoes administrativas.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Porta do servidor web
PORT=3000

# Segredo usado para assinar o cookie de sessao E os links de visita (validade 2h).
# Troque por um texto aleatorio longo. Se mudar, os links de visita ja enviados param de valer.
SESSION_SECRET=troque-este-segredo-por-algo-bem-aleatorio

# ===============================================
# Push Notifications (Web Push / VAPID)
# Gere um par de chaves com:  npx web-push generate-vapid-keys
# ===============================================
VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
# Contato exigido pelo padrao Web Push (um mailto: ou URL do responsavel)
VAPID_SUBJECT=mailto:contato@parkplace.com

# ===============================================
# Notificacoes por WhatsApp (Meta Cloud API)
# Avisa o morador quando o porteiro registra a entrada de uma
# visita / encomenda / iFood. Mensagem business-initiated => exige
# TEMPLATE "utility" aprovado pela Meta (fora da janela de 24h).
#
# Onde obter: https://developers.facebook.com/ (crie um App > produto
# WhatsApp). O PHONE_NUMBER_ID e o token ficam em "API Setup".
# ===============================================

# Liga/desliga o envio. Se "false" (ou credenciais vazias), o sistema
# NAO envia WhatsApp (o registro de entrada continua funcionando igual).
WHATSAPP_ATIVO=false

# Token de acesso da Cloud API (temporario no modo de teste, ou um token
# permanente de System User para producao).
WHATSAPP_TOKEN=

# ID do numero de telefone remetente (WhatsApp Manager > API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# Nome do template utility aprovado e idioma. O template deve ter 3
# variaveis no corpo, nesta ordem: {{1}} o que chegou, {{2}} destino, {{3}} horario.
WHATSAPP_TEMPLATE_ENTRADA=aviso_entrada_portaria
WHATSAPP_TEMPLATE_LANG=pt_BR

# Versao da Graph API (opcional).
WHATSAPP_API_VERSION=v21.0

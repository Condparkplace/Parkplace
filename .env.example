# ===============================================
# Configuracao do Supabase - Park Place Portaria
# Copie este arquivo para ".env" e preencha os valores
# ===============================================

# URL do seu projeto Supabase (Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publica "anon" (Settings > API > Project API keys > anon public)
# Usada para autenticacao dos usuarios (login).
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave "service_role" (Settings > API > Project API keys > service_role)
# ATENCAO: chave secreta de administrador. NUNCA exponha no frontend.
# Usada no backend para criar usuarios e operacoes administrativas.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Porta do servidor web
PORT=3000

# Segredo usado para assinar o cookie de sessao E os links de visita (validade 2h).
# Troque por um texto aleatorio longo. Se mudar, os links de visita ja enviados param de valer.
SESSION_SECRET=troque-este-segredo-por-algo-bem-aleatorio

# ===============================================
# Push Notifications (Web Push / VAPID)
# Gere um par de chaves com:  npx web-push generate-vapid-keys
# ===============================================
VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
# Contato exigido pelo padrao Web Push (um mailto: ou URL do responsavel)
VAPID_SUBJECT=mailto:contato@parkplace.com

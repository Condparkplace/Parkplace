{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parkplace",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Domínios customizados do Worker. Mantê-los aqui evita que um deploy
  // remova os domínios configurados no dashboard da Cloudflare.
  "routes": [
    { "pattern": "associacaoparkplace.com.br", "custom_domain": true },
    { "pattern": "www.associacaoparkplace.com.br", "custom_domain": true }
  ]
}

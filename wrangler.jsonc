{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parkplace",
  "main": "worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
